{
  "name": "ninja-board",
  "version": "1.0.2",
  "author": "AlexSendula",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node --import ./test/obsidian-hook.mjs --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "pretypecheck": "node scripts/sample-json.mjs",
    "typecheck": "tsc --noEmit",
    "prelint": "node scripts/sample-json.mjs",
    "lint": "eslint src preview",
    "preview": "node scripts/sample-json.mjs && node esbuild.config.mjs preview && node scripts/serve.mjs",
    "sandbox": "node scripts/sandbox.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "linkedom": "0.18.13",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "yaml": "2.9.1"
  }
}
