    {"name": "a month end drifts: each step counts from the due date being completed", "before": {"type": "task", "status": "open", "repeat": "every month", "due": "2026-02-28"}, "today": "2026-02-28", "body": "## Tasks\n", "expect": {"type": "task", "status": "open", "repeat": "every month", "due": "2026-03-28"}, "expectBody": "## Tasks\n\n## Log\n- 2026-02-28 Done: the occurrence due 2026-02-28. Next due 2026-03-28.\n"},
