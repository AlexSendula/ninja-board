    {"name": "Dentist: counted from the done date", "before": {"type": "task", "status": "open", "repeat": "every 6 months", "repeat_from": "done", "due": "2026-10-16"}, "today": "2026-10-20", "body": "## Tasks\n", "expect": {"type": "task", "status": "open", "repeat": "every 6 months", "repeat_from": "done", "due": "2027-04-20"}, "expectBody": "## Tasks\n\n## Log\n- 2026-10-20 Done: the occurrence due 2026-10-16. Next due 2027-04-20.\n"},
